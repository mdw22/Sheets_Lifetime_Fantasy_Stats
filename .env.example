# Copy to .env (git-ignored) and fill in. Never commit real values.
ESPN_LEAGUE_ID=PLACEHOLDER_LEAGUE_ID
ESPN_SEASON_YEAR=2026
ESPN_S2=PLACEHOLDER_ESPN_S2
SWID=PLACEHOLDER_SWID
# Optional; defaults to the all-years sheet. Point at a DUPLICATE for testing.
GOOGLE_SHEET_ID=
# Either the key JSON itself, or a path to a git-ignored key file.
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
# Not read locally. SYNC_ENABLED is a GitHub repo VARIABLE (Settings -> Secrets and variables -> Actions -> Variables).
# Only the exact value "true" lets scheduled/manual runs write to the sheet (passes --commit --allow-production).
# Anything else: scheduled runs are dry runs and manual commit=true is refused.
# SYNC_ENABLED=true
